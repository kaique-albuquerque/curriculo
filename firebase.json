{
  "hosting": [
    {
      "target": "curriculo",
      "public": "dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/kaique-albuquerque-curriculo-pt.pdf",
          "destination": "/kaique-albuquerque-curriculo.pdf",
          "type": 301
        },
        {
          "source": "/kaique-albuquerque-curriculo-en.pdf",
          "destination": "/kaique-albuquerque-curriculo.pdf",
          "type": 301
        }
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(pdf)",
          "headers": [
            { "key": "Content-Type", "value": "application/pdf" },
            { "key": "Content-Disposition", "value": "inline" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "**/*.@(png|svg|jpg|jpeg|webp)",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
        },
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    },
    {
      "target": "antigo",
      "public": "dist",
      "redirects": [
        {
          "source": "/",
          "destination": "https://curriculokaique.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://curriculokaique.web.app/:path",
          "type": 301
        }
      ]
    }
  ]
}